# --- REQUIRED ---

# LiveKit project (Cloud dashboard -> Settings -> Project)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sarvam AI (https://dashboard.sarvam.ai -> API Keys)
# Used for both STT (Saaras v3) and TTS (Bulbul v3).
SARVAM_API_KEY=

# --- OPTIONAL ---

# Only needed if you want to bypass LiveKit Inference and call Gemini
# directly. Not required by default — LiveKit Inference credits cover the
# LLM calls in agent/main.py (inference.LLM("google/gemini-2.5-flash")).
GOOGLE_API_KEY=

# LLM backend: "gemini" (default, recommended — cheap + reliable Telugu
# output) or "ollama" (local, $0 marginal cost, but Telugu/code-switching
# quality is unverified for open local models — test before relying on it).
# See README "Cost optimization" section before switching this.
BVHOMES_LLM_PROVIDER=gemini

# Only used when BVHOMES_LLM_PROVIDER=ollama. Requires `ollama serve` running
# locally/on your server and `uv sync --extra ollama` for the plugin.
BVHOMES_OLLAMA_BASE_URL=http://localhost:11434/v1
BVHOMES_OLLAMA_MODEL=llama3.3:8b

# Where the SQLite leads database lives. In Docker, mount a volume at this
# path so leads survive container restarts (see Dockerfile / README).
BVHOMES_DB_PATH=data/leads.db

# Production PostgreSQL (optional). When set, this takes precedence over
# BVHOMES_DB_PATH for leads, conversations, the API, and dashboard.
# DATABASE_URL=postgresql://bvhomes:password@db-host:5432/bvhomes
DATABASE_URL=

# DEBUG / INFO / WARNING / ERROR
BVHOMES_LOG_LEVEL=INFO

# Sarvam Bulbul v3 speaker name. Listen to samples and change after testing:
# https://docs.livekit.io/agents/models/tts/sarvam/
BVHOMES_TTS_SPEAKER=anushka
