# Local-only BV Homes configuration

# Ollama OpenAI-compatible endpoint
BVHOMES_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
BVHOMES_OLLAMA_MODEL=qwen3.6:latest

# Local STT
BVHOMES_STT_MODEL=small
BVHOMES_STT_DEVICE=cpu
BVHOMES_STT_COMPUTE_TYPE=int8

# Local Piper TTS
BVHOMES_PIPER_URL=http://127.0.0.1:5000
BVHOMES_PIPER_VOICE=

# Local database
BVHOMES_LOCAL_DB=local/data/bvhomes_local.db

# Self-hosted LiveKit
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
